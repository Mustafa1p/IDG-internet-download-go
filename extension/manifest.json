{
  "manifest_version": 3,
  "name": "IDG Integration Module",
  "description": "Intercepts browser downloads and sends them to IDG for parallel multi-segment downloading",
  "version": "1.4.1",
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "48": "images/icon48.png"
    },
    "default_popup": "popup.html",
    "default_title": "IDG Integration Module"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "js": [
        "content.js"
      ],
      "matches": [
        "*://*/*"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "downloads",
    "management",
    "tabs",
    "cookies",
    "contextMenus",
    "storage",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:17843/"
  ],
  "minimum_chrome_version": "109.0",
  "key": ""
}
