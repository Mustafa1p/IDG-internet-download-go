  "fix": "Skip cooperative handoff when at most 64 KiB remains, including a fresh check after buffered bytes are acknowledged. Ordinary inactivity/retry behavior remains active.",
  "cli_fixture_source": "import hashlib, json, subprocess, threading, time\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\nfrom pathlib import Path\nROOT = Path(__file__).resolve().parents[1]\nOUT = ROOT / \"target/tiny-tail-cli-verification\"\nOUT.mkdir(exist_ok=False)\nDATA = hashlib.shake_256(b\"IDG tiny valid response tail v1\").digest(8 * 1024 * 1024 + 19)\nEXPECTED = hashlib.sha256(DATA).hexdigest()\nresults = []\nfor name, executable, success in [(\"before\", \"perf-idg-handoff-observation.exe\", False), (\"after\", \"perf-idg-tiny-tail-fixed.exe\", True)]:\n    seen = []; lock = threading.Lock(); sent = threading.Event(); release = threading.Event()\n    class Handler(BaseHTTPRequestHandler):\n        protocol_version = \"HTTP/1.1\"\n        def log_message(self, *args): pass\n        def do_GET(self):\n            start, end = map(int, self.headers[\"Range\"].removeprefix(\"bytes=\").split(\"-\"))\n            end = min(end, len(DATA) - 1)\n            with lock:\n                target = next((r for r in seen if r[\"start\"] == 2 * 1024 * 1024), None)\n                forbidden = target is not None and target[\"start\"] < start <= target[\"end\"]\n                seen.append({\"start\": start, \"end\": end, \"status\": 403 if forbidden else 206, \"if_range\": self.headers.get(\"If-Range\")})\n            self.send_response(403 if forbidden else 206)\n            self.send_header(\"Content-Length\", str(0 if forbidden else end - start + 1))\n            self.send_header(\"Connection\", \"close\")\n            if forbidden:\n                self.end_headers(); return\n            self.send_header(\"Content-Type\", \"application/octet-stream\")\n            self.send_header(\"Content-Range\", f\"bytes {start}-{end}/{len(DATA)}\")\n            self.send_header(\"ETag\", '\"fixed\"'); self.end_headers()\n            try:\n                if start == 2 * 1024 * 1024:\n                    cursor = end + 1 - 40 * 1024\n                    self.wfile.write(DATA[start:cursor]); self.wfile.flush(); sent.set()\n                    release.wait(5)\n                    self.wfile.write(DATA[cursor:end + 1])\n                else: self.wfile.write(DATA[start:end + 1])\n            except (BrokenPipeError, ConnectionResetError, ConnectionAbortedError): pass\n    server = ThreadingHTTPServer((\"127.0.0.1\", 0), Handler); server.daemon_threads = True\n    serving = threading.Thread(target=server.serve_forever, daemon=True); serving.start()\n    def release_tail():\n        if sent.wait(5): time.sleep(0.5)\n        release.set()\n    releasing = threading.Thread(target=release_tail, daemon=True); releasing.start()\n    destination = OUT / (name + \".bin\"); binary = ROOT / \"target\" / executable\n    try:\n        process = subprocess.run([str(binary), f\"http://127.0.0.1:{server.server_port}/fixture.bin\", str(destination), \"0\"], capture_output=True, text=True, encoding=\"utf-8\", errors=\"replace\", timeout=20)\n    finally:\n        release.set(); releasing.join(); server.shutdown(); server.server_close(); serving.join()\n    actual = hashlib.sha256(destination.read_bytes()).hexdigest() if destination.exists() else None\n    row = {\"name\":name, \"binary_sha256\":hashlib.sha256(binary.read_bytes()).hexdigest(), \"expected_success\":success, \"exit_code\":process.returncode, \"actual_size\":destination.stat().st_size if destination.exists() else None, \"actual_sha256\":actual, \"expected_size\":len(DATA), \"expected_sha256\":EXPECTED, \"requests\":seen, \"stdout\":process.stdout, \"stderr\":process.stderr}\n    assert (process.returncode == 0) == success, row\n    if success:\n        assert actual == EXPECTED and row[\"actual_size\"] == len(DATA), row\n        assert all(r[\"status\"] == 206 for r in seen), row\n    else:\n        assert \"403\" in process.stderr and any(r[\"status\"] == 403 for r in seen), row\n    row[\"verified\"] = True; results.append(row)\n(OUT / \"results.json\").write_text(json.dumps({\"fixture_sha256\":hashlib.sha256(Path(__file__).read_bytes()).hexdigest(), \"results\":results}, indent=2) + \"\\n\", encoding=\"utf-8\")\nprint(json.dumps([{k:r[k] for k in [\"name\", \"expected_success\", \"exit_code\", \"actual_sha256\", \"verified\"]} for r in results], indent=2))\n",
